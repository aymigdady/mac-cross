# Copy to .env for local docker compose
CCAPR_CROSS_SERVICE_TOKEN=dev-cross-token
ANTHROPIC_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
CCAPR_ENABLE_EMBEDDINGS=1
CCAPR_ENABLE_EMBEDDINGS_PER_COMPANY=MBL
CCAPR_USE_CROSS_ENCODER=1
CCAPR_USE_QUERY_EXPANSION=1
# GCS bucket for HNSW index persistence (unset = local-only, no GCS)
# CCAPR_GCS_BUCKET=mac-cost-intellegence-ccapr-artifacts
